datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  SALES_MANAGER
  SALES_REP
  FINANCE_OPERATIONS
  CUSTOMER
}

enum BillingType {
  ONE_TIME
  RECURRING
}

enum RecurringPeriod {
  MONTHLY
  ANNUAL
}

enum QuoteStatus {
  DRAFT
  PENDING_MANAGER
  PENDING_FINANCE
  APPROVED
  REJECTED
  NEGOTIATING
  FULFILLMENT
  BILLING
  COMPLETED
}

enum RecommendationRuleType {
  CO_PURCHASE
  PROMOTION
  CROSS_SELL
  UPSELL
}

model User {
  id              String           @id @default(uuid())
  email           String           @unique
  passwordHash    String
  name            String
  role            Role             @default(SALES_REP)
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  refreshSessions RefreshSession[]
  quotations      Quotation[]
  approvalRequests ApprovalRequest[]
  actedApprovalSteps ApprovalStep[]
  invoices        Invoice[]
}

model RefreshSession {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  isRevoked Boolean  @default(false)
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

enum CustomerTier {
  ENTERPRISE
  GOLD
  SILVER
  BRONZE
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

model Customer {
  id        String         @id @default(uuid())
  code      String         @unique
  name      String
  email     String
  phone     String?
  tier      CustomerTier   @default(SILVER)
  status    CustomerStatus @default(ACTIVE)
  creditLimit    Float        @default(50000)
  region         String       @default("US-East")
  accountManager String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  quotations     Quotation[]
  invoices       Invoice[]
  
  @@index([tier])
  @@index([status])
}

model Category {
  id          String            @id @default(uuid())
  name        String            @unique
  code        String            @unique
  description String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  products    ProductCategory[]
}

model ProductCategory {
  productId  String
  categoryId String
  isPrimary  Boolean  @default(false)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
  @@index([productId])
  @@index([categoryId])
}

model Product {
  id                  String                  @id @default(uuid())
  sku                 String                  @unique
  name                String
  description         String?
  category            String               @default("HARDWARE")
  unit                String               @default("Unit")
  taxRate             Float                @default(0.0)
  listPrice           Float
  standardCost        Float
  maxAllowedDiscount  Float                   @default(15.0)
  billingType         BillingType             @default(ONE_TIME)
  recurringPeriod     RecurringPeriod?
  isActive            Boolean                 @default(true)
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
  categories          ProductCategory[]
  variants            ProductVariant[]
  priceListEntries    PriceListEntry[]
  quoteLines          QuoteLine[]
  discountPolicyRules DiscountPolicyRule[]
  sourceRules         RecommendationRule[]    @relation("SourceProductRules")
  recommendedRules    RecommendationRule[]    @relation("RecommendedProductRules")
  inventory           InventoryItem[]
  inventoryMovements  InventoryMovement[]
  backorders          Backorder[]
  invoiceLines        InvoiceLine[]

  @@index([category])
  @@index([sku])
}

model ProductAttribute {
  id        String                  @id @default(uuid())
  name      String                  @unique
  createdAt DateTime                @default(now())
  updatedAt DateTime                @updatedAt
  values    ProductAttributeValue[]
}

model ProductAttributeValue {
  id          String                  @id @default(uuid())
  attributeId String
  attribute   ProductAttribute        @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  value       String
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
  variants    VariantAttributeValue[]

  @@unique([attributeId, value])
  @@index([attributeId])
}

model ProductVariant {
  id         String                  @id @default(uuid())
  productId  String
  product    Product                 @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku        String                  @unique
  name       String
  extraPrice Float                   @default(0.0)
  isActive   Boolean                 @default(true)
  createdAt  DateTime                @default(now())
  updatedAt  DateTime                @updatedAt
  attributes VariantAttributeValue[]
  inventory  InventoryItem[]
  movements  InventoryMovement[]
  backorders Backorder[]

  @@index([productId])
}

model VariantAttributeValue {
  variantId        String
  attributeValueId String
  variant          ProductVariant        @relation(fields: [variantId], references: [id], onDelete: Cascade)
  attributeValue   ProductAttributeValue @relation(fields: [attributeValueId], references: [id], onDelete: Cascade)

  @@id([variantId, attributeValueId])
  @@index([variantId])
  @@index([attributeValueId])
}

model PriceList {
  id           String           @id @default(uuid())
  name         String
  customerTier CustomerTier?
  currency     String           @default("USD")
  isDefault    Boolean          @default(false)
  isActive     Boolean          @default(true)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  entries      PriceListEntry[]

  @@index([customerTier])
  @@index([currency])
}

model PriceListEntry {
  id          String    @id @default(uuid())
  priceListId String
  priceList   PriceList @relation(fields: [priceListId], references: [id], onDelete: Cascade)
  productId   String
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  unitPrice   Float
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([priceListId, productId])
  @@index([productId])
}

model Quotation {
  id                     String                  @id @default(uuid())
  quoteNumber            String                  @unique
  customerId             String
  customer               Customer                @relation(fields: [customerId], references: [id])
  createdById            String
  createdBy              User                    @relation(fields: [createdById], references: [id])
  status                 QuoteStatus             @default(DRAFT)
  subtotal               Float                   @default(0)
  totalDiscount          Float                   @default(0)
  taxableAmount          Float                   @default(0)
  taxAmount              Float                   @default(0)
  netValue               Float                   @default(0)
  grossMarginPercent     Float                   @default(0)
  riskScore              Float                   @default(0)
  riskLevel              String                  @default("LOW")
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  lines                  QuoteLine[]
  portalTokens           PortalToken[]
  counterOffers          CounterOffer[]
  fulfillmentAllocations FulfillmentAllocation[]
  backorders             Backorder[]
  billingSchedule        BillingSchedule?
  dealAlerts             DealAlert[]
  approvalRequests       ApprovalRequest[]
  invoices               Invoice[]
}

model PortalToken {
  id          String    @id @default(uuid())
  token       String    @unique @default(uuid())
  quotationId String
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  expiresAt   DateTime
  isRevoked   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([quotationId])
  @@index([token])
}

model CounterOffer {
  id                      String    @id @default(uuid())
  quotationId             String
  quotation               Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  proposedDiscountPercent Float
  customerNotes           String?
  status                  String    @default("SUBMITTED")
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  @@index([quotationId])
}

model QuoteLine {
  id                      String                  @id @default(uuid())
  quotationId             String
  quotation               Quotation               @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  productId               String
  product                 Product                 @relation(fields: [productId], references: [id])
  quantity                Int                     @default(1)
  listPrice               Float
  unitPrice               Float                   @default(0)
  proposedDiscountPercent Float                   @default(0)
  discountAmount          Float                   @default(0)
  taxRate                 Float                   @default(0)
  taxAmount               Float                   @default(0)
  netLinePrice            Float
  lineCost                Float
  lineMarginPercent       Float
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt
  allocations             FulfillmentAllocation[]
  backorders              Backorder[]

  @@index([quotationId])
  @@index([productId])
}


model RecommendationRule {
  id                      String                 @id @default(uuid())
  sourceProductId         String?
  sourceProduct           Product?               @relation("SourceProductRules", fields: [sourceProductId], references: [id], onDelete: Cascade)
  recommendedProductId    String
  recommendedProduct      Product                @relation("RecommendedProductRules", fields: [recommendedProductId], references: [id], onDelete: Cascade)
  ruleType                RecommendationRuleType @default(CO_PURCHASE)
  reasonTemplate          String
  priority                Int                    @default(10)
  promotionDiscountPercent Float?
  isActive                Boolean                @default(true)
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt

  @@index([sourceProductId])
  @@index([recommendedProductId])
}

model DiscountPolicyRule {
  id                   String        @id @default(uuid())
  name                 String
  description          String?
  customerTier         CustomerTier?
  category             String?
  productId            String?
  product              Product?      @relation(fields: [productId], references: [id], onDelete: Cascade)
  maxDiscountPercent   Float
  minMarginPercent     Float?
  requiredApprovalRole Role          @default(SALES_MANAGER)
  priority             Int           @default(10)
  isActive             Boolean       @default(true)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  @@index([customerTier])
  @@index([category])
  @@index([productId])
  @@index([isActive])
}

model Warehouse {
  id           String                  @id @default(uuid())
  code         String                  @unique
  name         String
  description  String?
  location     String
  priority     Int                     @default(10)
  isActive     Boolean                 @default(true)
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt
  inventory    InventoryItem[]
  allocations  FulfillmentAllocation[]
  movements    InventoryMovement[]
}

model InventoryItem {
  id                String          @id @default(uuid())
  warehouseId       String
  warehouse         Warehouse       @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  productId         String
  product           Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  productVariantId  String?
  productVariant    ProductVariant? @relation(fields: [productVariantId], references: [id], onDelete: Cascade)
  onHandQuantity    Int             @default(0)
  reservedQuantity  Int             @default(0)
  availableQuantity Int             @default(0)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@unique([warehouseId, productId])
  @@index([productId])
  @@index([warehouseId])
  @@index([productVariantId])
}

model FulfillmentAllocation {
  id                  String              @id @default(uuid())
  quotationId         String
  quotation           Quotation           @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  quoteLineId         String
  quoteLine           QuoteLine           @relation(fields: [quoteLineId], references: [id], onDelete: Cascade)
  warehouseId         String
  warehouse           Warehouse           @relation(fields: [warehouseId], references: [id])
  allocatedQuantity   Int
  backorderedQuantity Int                 @default(0)
  status              String              @default("RESERVED")
  explanation         Json?
  isOverride          Boolean             @default(false)
  overrideReason      String?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  movements           InventoryMovement[]
  backorders          Backorder[]

  @@index([quotationId])
  @@index([quoteLineId])
  @@index([warehouseId])
  @@index([status])
}

enum InventoryMovementType {
  RECEIPT
  RESERVATION
  RESERVATION_RELEASE
  SHIPMENT
  RETURN
  ADJUSTMENT
  TRANSFER_IN
  TRANSFER_OUT
}

model InventoryMovement {
  id                      String                 @id @default(uuid())
  warehouseId             String
  warehouse               Warehouse              @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  productId               String
  product                 Product                @relation(fields: [productId], references: [id], onDelete: Cascade)
  productVariantId        String?
  productVariant          ProductVariant?        @relation(fields: [productVariantId], references: [id], onDelete: Cascade)
  movementType            InventoryMovementType
  quantity                Int
  onHandBefore            Int                    @default(0)
  onHandAfter             Int                    @default(0)
  reservedBefore          Int                    @default(0)
  reservedAfter           Int                    @default(0)
  referenceType           String?
  referenceId             String?
  fulfillmentAllocationId String?
  fulfillmentAllocation   FulfillmentAllocation? @relation(fields: [fulfillmentAllocationId], references: [id], onDelete: SetNull)
  reason                  String?
  actorId                 String?
  actorName               String?
  createdAt               DateTime               @default(now())

  @@index([warehouseId])
  @@index([productId])
  @@index([createdAt])
  @@index([movementType])
}

enum BackorderStatus {
  BACKORDERED
  PARTIALLY_REALLOCATED
  RESOLVED
  CANCELLED
}

model Backorder {
  id                      String                 @id @default(uuid())
  quotationId             String
  quotation               Quotation              @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  quoteLineId             String
  quoteLine               QuoteLine              @relation(fields: [quoteLineId], references: [id], onDelete: Cascade)
  fulfillmentAllocationId String?
  fulfillmentAllocation   FulfillmentAllocation? @relation(fields: [fulfillmentAllocationId], references: [id], onDelete: SetNull)
  productId               String
  product                 Product                @relation(fields: [productId], references: [id], onDelete: Cascade)
  productVariantId        String?
  productVariant          ProductVariant?        @relation(fields: [productVariantId], references: [id], onDelete: SetNull)
  requestedQuantity       Int
  allocatedQuantity       Int                    @default(0)
  backorderedQuantity     Int
  status                  BackorderStatus        @default(BACKORDERED)
  notes                   String?
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt

  @@index([quotationId])
  @@index([quoteLineId])
  @@index([productId])
  @@index([status])
}

model BillingSchedule {
  id                    String        @id @default(uuid())
  quotationId           String        @unique
  quotation             Quotation     @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  totalOneTimeAmount    Float         @default(0)
  totalRecurringMonthly Float         @default(0)
  totalRecurringAnnual  Float         @default(0)
  billingStartDate      DateTime      @default(now())
  status                String        @default("ACTIVE")
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  lines                 BillingLine[]
}

model BillingLine {
  id                String           @id @default(uuid())
  billingScheduleId String
  billingSchedule   BillingSchedule  @relation(fields: [billingScheduleId], references: [id], onDelete: Cascade)
  quoteLineId       String?
  productName       String
  billingType       BillingType      @default(ONE_TIME)
  recurringPeriod   RecurringPeriod?
  billingDate       DateTime
  amount            Float
  proratedDays      Int?
  isProrated        Boolean          @default(false)
  status            String           @default("PENDING")
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([billingScheduleId])
}

model DealAlert {
  id          String    @id @default(uuid())
  quotationId String
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  alertType   String
  severity    String    @default("WARNING")
  message     String
  isResolved  Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([quotationId])
  @@index([alertType])
  @@index([isResolved])
}

enum ApprovalRequestStatus {
  PENDING
  APPROVED
  REJECTED
  SUPERSEDED
}

enum ApprovalStepStatus {
  PENDING
  APPROVED
  REJECTED
  SUPERSEDED
}

model ApprovalRequest {
  id                  String                @id @default(uuid())
  quotationId         String?
  quotation           Quotation?            @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  requestedById       String
  requestedBy         User                  @relation(fields: [requestedById], references: [id])
  status              ApprovalRequestStatus @default(PENDING)
  riskScore           Float                 @default(0)
  riskLevel           String                @default("LOW")
  netTotal            Float                 @default(0)
  marginAmount        Float                 @default(0)
  marginPercentage    Float                 @default(0)
  violations          Json?
  commercialSummary   Json?
  currentStepSequence Int                   @default(1)
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  steps               ApprovalStep[]

  @@index([quotationId])
  @@index([requestedById])
  @@index([status])
}

model ApprovalStep {
  id                String             @id @default(uuid())
  approvalRequestId String
  approvalRequest   ApprovalRequest    @relation(fields: [approvalRequestId], references: [id], onDelete: Cascade)
  sequence          Int                @default(1)
  requiredRole      Role
  status            ApprovalStepStatus @default(PENDING)
  actedById         String?
  actedBy           User?              @relation(fields: [actedById], references: [id])
  actedAt           DateTime?
  comments          String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([approvalRequestId])
  @@index([requiredRole])
  @@index([status])
}

model AuditLog {
  id            String   @id @default(uuid())
  eventType     String
  action        String
  entityType    String
  entityId      String
  actorId       String?
  actorName     String?
  actorRole     Role?
  previousState Json?
  newState      Json?
  changes       Json?
  metadata      Json?
  createdAt     DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
  @@index([actorId])
  @@index([eventType])
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  VOID
}

model Invoice {
  id            String        @id @default(uuid())
  invoiceNumber String        @unique
  quotationId   String        @unique
  quotation     Quotation     @relation(fields: [quotationId], references: [id])
  customerId    String
  customer      Customer      @relation(fields: [customerId], references: [id])
  customerName  String
  customerEmail String
  customerPhone String?
  customerTier  CustomerTier  @default(SILVER)
  customerRegion String       @default("US-East")
  status        InvoiceStatus @default(ISSUED)
  issueDate     DateTime      @default(now())
  dueDate       DateTime?
  subtotal      Float         @default(0)
  totalDiscount Float         @default(0)
  taxableAmount Float         @default(0)
  taxAmount     Float         @default(0)
  totalAmount   Float         @default(0)
  notes         String?
  createdById   String?
  createdBy     User?         @relation(fields: [createdById], references: [id])
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  lines         InvoiceLine[]

  @@index([customerId])
  @@index([quotationId])
  @@index([status])
  @@index([invoiceNumber])
}

model InvoiceLine {
  id                      String   @id @default(uuid())
  invoiceId               String
  invoice                 Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  productId               String?
  product                 Product? @relation(fields: [productId], references: [id])
  productName             String
  productSku              String
  quantity                Int      @default(1)
  listPrice               Float    @default(0)
  unitPrice               Float    @default(0)
  proposedDiscountPercent Float    @default(0)
  discountAmount          Float    @default(0)
  taxRate                 Float    @default(0)
  taxAmount               Float    @default(0)
  taxableAmount           Float    @default(0)
  lineTotal               Float    @default(0)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@index([invoiceId])
  @@index([productId])
}

