datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  SALES_MANAGER
  SALES_REP
  FINANCE_OPERATIONS
  CUSTOMER
}

enum BillingType {
  ONE_TIME
  RECURRING
}

enum RecurringPeriod {
  MONTHLY
  ANNUAL
}

enum QuoteStatus {
  DRAFT
  PENDING_MANAGER
  PENDING_FINANCE
  APPROVED
  NEGOTIATING
  FULFILLMENT
  BILLING
  COMPLETED
}

enum RecommendationRuleType {
  CO_PURCHASE
  PROMOTION
  CROSS_SELL
  UPSELL
}

model User {
  id              String           @id @default(uuid())
  email           String           @unique
  passwordHash    String
  name            String
  role            Role             @default(SALES_REP)
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  refreshSessions RefreshSession[]
  quotations      Quotation[]
}

model RefreshSession {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  isRevoked Boolean  @default(false)
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

enum CustomerTier {
  ENTERPRISE
  TIER_1
  TIER_2
  TIER_3
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

model Customer {
  id        String         @id @default(uuid())
  code      String         @unique
  name      String
  email     String
  phone     String?
  tier      CustomerTier   @default(TIER_2)
  status    CustomerStatus @default(ACTIVE)
  creditLimit    Float        @default(50000)
  region         String       @default("US-East")
  accountManager String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  quotations     Quotation[]
  
  @@index([tier])
  @@index([status])
}

model Product {
  id                  String                  @id @default(uuid())
  sku                 String                  @unique
  name                String
  category            String
  listPrice           Float
  standardCost        Float
  billingType         BillingType             @default(ONE_TIME)
  recurringPeriod     RecurringPeriod?
  isActive            Boolean                 @default(true)
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
  quoteLines          QuoteLine[]
  sourceRules         RecommendationRule[]    @relation("SourceProductRules")
  recommendedRules    RecommendationRule[]    @relation("RecommendedProductRules")
  inventory           InventoryItem[]
}

model Quotation {
  id                     String                  @id @default(uuid())
  quoteNumber            String                  @unique
  customerId             String
  customer               Customer                @relation(fields: [customerId], references: [id])
  createdById            String
  createdBy              User                    @relation(fields: [createdById], references: [id])
  status                 QuoteStatus             @default(DRAFT)
  subtotal               Float                   @default(0)
  totalDiscount          Float                   @default(0)
  netValue               Float                   @default(0)
  grossMarginPercent     Float                   @default(0)
  riskScore              Float                   @default(0)
  riskLevel              String                  @default("LOW")
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  lines                  QuoteLine[]
  portalTokens           PortalToken[]
  counterOffers          CounterOffer[]
  fulfillmentAllocations FulfillmentAllocation[]
  billingSchedule        BillingSchedule?
}

model PortalToken {
  id          String    @id @default(uuid())
  token       String    @unique @default(uuid())
  quotationId String
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  expiresAt   DateTime
  isRevoked   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([quotationId])
  @@index([token])
}

model CounterOffer {
  id                      String    @id @default(uuid())
  quotationId             String
  quotation               Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  proposedDiscountPercent Float
  customerNotes           String?
  status                  String    @default("SUBMITTED")
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  @@index([quotationId])
}

model QuoteLine {
  id                      String                  @id @default(uuid())
  quotationId             String
  quotation               Quotation               @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  productId               String
  product                 Product                 @relation(fields: [productId], references: [id])
  quantity                Int                     @default(1)
  listPrice               Float
  proposedDiscountPercent Float                   @default(0)
  discountAmount          Float                   @default(0)
  netLinePrice            Float
  lineCost                Float
  lineMarginPercent       Float
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt
  allocations             FulfillmentAllocation[]

  @@index([quotationId])
  @@index([productId])
}


model RecommendationRule {
  id                      String                 @id @default(uuid())
  sourceProductId         String?
  sourceProduct           Product?               @relation("SourceProductRules", fields: [sourceProductId], references: [id], onDelete: Cascade)
  recommendedProductId    String
  recommendedProduct      Product                @relation("RecommendedProductRules", fields: [recommendedProductId], references: [id], onDelete: Cascade)
  ruleType                RecommendationRuleType @default(CO_PURCHASE)
  reasonTemplate          String
  priority                Int                    @default(10)
  promotionDiscountPercent Float?
  isActive                Boolean                @default(true)
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt

  @@index([sourceProductId])
  @@index([recommendedProductId])
}

model Warehouse {
  id           String                  @id @default(uuid())
  code         String                  @unique
  name         String
  location     String
  isActive     Boolean                 @default(true)
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt
  inventory    InventoryItem[]
  allocations  FulfillmentAllocation[]
}

model InventoryItem {
  id                String    @id @default(uuid())
  warehouseId       String
  warehouse         Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  productId         String
  product           Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  availableQuantity Int       @default(0)
  reservedQuantity  Int       @default(0)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([warehouseId, productId])
  @@index([productId])
  @@index([warehouseId])
}

model FulfillmentAllocation {
  id                String    @id @default(uuid())
  quotationId       String
  quotation         Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  quoteLineId       String
  quoteLine         QuoteLine @relation(fields: [quoteLineId], references: [id], onDelete: Cascade)
  warehouseId       String
  warehouse         Warehouse @relation(fields: [warehouseId], references: [id])
  allocatedQuantity Int
  isOverride        Boolean   @default(false)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([quotationId])
  @@index([quoteLineId])
  @@index([warehouseId])
}

model BillingSchedule {
  id                    String        @id @default(uuid())
  quotationId           String        @unique
  quotation             Quotation     @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  totalOneTimeAmount    Float         @default(0)
  totalRecurringMonthly Float         @default(0)
  totalRecurringAnnual  Float         @default(0)
  billingStartDate      DateTime      @default(now())
  status                String        @default("ACTIVE")
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  lines                 BillingLine[]
}

model BillingLine {
  id                String           @id @default(uuid())
  billingScheduleId String
  billingSchedule   BillingSchedule  @relation(fields: [billingScheduleId], references: [id], onDelete: Cascade)
  quoteLineId       String?
  productName       String
  billingType       BillingType      @default(ONE_TIME)
  recurringPeriod   RecurringPeriod?
  billingDate       DateTime
  amount            Float
  proratedDays      Int?
  isProrated        Boolean          @default(false)
  status            String           @default("PENDING")
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([billingScheduleId])
}



