datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String
  role      String   @default("SALES_REP")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
