# Database Configuration
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/dealflow360?schema=public"

# Authentication Secrets & Expirations
JWT_ACCESS_SECRET="dev-jwt-access-secret-min-32-chars-long-key"
JWT_REFRESH_SECRET="dev-jwt-refresh-secret-min-32-chars-long-key"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Server Configuration
PORT=3000
NODE_ENV="development"
CORS_ORIGIN="http://localhost:5173"

# Web Client Configuration
VITE_API_BASE_URL="http://localhost:3000/api/v1"
